# Optional: identifies you to the OpenAlex "polite pool" for better rate limits.
OPENALEX_MAILTO=you@example.com

# Optional: minimum gap in ms between OpenAlex calls (default 110).
# Raise this if you still see HTTP 429 warnings in search responses.
OPENALEX_MIN_GAP_MS=110

# Optional: set to "playwright" to enable JS-rendered lab-page scraping.
SCRAPER_MODE=fetch

# Optional: PostgreSQL / Supabase connection for persistent PI caching.
DATABASE_URL=
